# Authentication (Clerk is the default provider across development and production)
VITE_AUTH_PROVIDER="clerk"
VITE_CLERK_JWT_TEMPLATE="vikingwinch_api"
# Clerk Publishable Key (automatically provided by Vercel-Clerk integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend API
VITE_API_URL="http://127.0.0.1:8000"
# Explicitly set to preview/local to render the development-only reset control.
VITE_ENVIRONMENT="local"

# Microsoft Entra ID (MSAL) — preserved for optional future production use
# To enable MSAL, set: VITE_AUTH_PROVIDER="msal"
VITE_AZURE_CLIENT_ID="ENTER_CLIENT_ID_HERE"
VITE_AZURE_TENANT_ID="ENTER_TENANT_ID_HERE"
VITE_API_SCOPE="api://your-api-app-id/.default"
