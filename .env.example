# Database Credentials
DB_USER=vgs_api
DB_PASSWORD=localdev_api
DB_NAME=vgs_management
DB_HOST=127.0.0.1
DB_PORT=3306

# Root DB password for docker-compose initialization
DB_ROOT_PASSWORD=localdev_root

# Application Environment (local, preview, production)
ENVIRONMENT=local
# Comma-separated service numbers allowed to use the development reset.
# Leave empty in production and configure production as ENVIRONMENT=production.
ADMIN_OPERATOR_SERVICE_NOS=

# Backend authentication
CLERK_ISSUER=https://your-clerk-issuer
CLERK_AUDIENCE=vikingwinch_api
CLERK_JWKS_URL=https://your-clerk-issuer/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
MSAL_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
MSAL_AUDIENCE=api://your-api-app-id
MSAL_JWKS_URL=https://login.microsoftonline.com/your-tenant/discovery/v2.0/keys
MSAL_GRAPH_TENANT_ID=your-tenant-id
MSAL_GRAPH_CLIENT_ID=your-graph-app-client-id
MSAL_GRAPH_CLIENT_SECRET=your-graph-app-client-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
